    {
      "id": "you_and_photos",
      "step": 1,
      "xp_weight": 30,
      "title": "You & photos",
      "subtitle": "Basics, prompts, and your best shots",
      "fields": [
        {
          "id": "display_name",
          "label": "Display name",
          "type": "text",
          "status": "required"
        },
        {
          "id": "gender",
          "label": "Gender",
          "type": "single_select",
          "status": "required",
          "options": [
            "Man",
            "Woman",
            "Non-binary",
            "Prefer not to say"
          ]
        },
        {
          "id": "city",
          "label": "Current city",
          "type": "city_search",
          "status": "required"
        },
        {
          "id": "home_state",
          "label": "Hometown",
          "type": "city_search",
          "status": "optional"
        },
        {
          "id": "height_cm",
          "label": "Height",
          "type": "number",
          "status": "optional",
          "min": 140,
          "max": 220
        },
        {
          "id": "body_type",
          "label": "Body type",
          "type": "single_select",
          "status": "optional",
          "options": [
            "Slim",
            "Average",
            "Athletic",
            "Heavyset",
            "Prefer not to say"
          ]
        },
        {
          "id": "marital_status",
          "label": "Marital status",
          "type": "single_select",
          "status": "required",
          "options": [
            "Never married",
            "Divorced",
            "Widowed",
            "Separated"
          ]
        },
        {
          "id": "has_children",
          "label": "Do you have children?",
          "type": "single_select",
          "status": "conditional",
          "options": [
            "No",
            "Yes — 1 child",
            "Yes — 2 children",
            "Yes — 3 or more"
          ],
          "show_if": {
            "field": "marital_status",
            "not_equals": "Never married"
          }
        },
        {
          "id": "grew_up_abroad",
          "label": "Did you grow up abroad?",
          "type": "single_select",
          "status": "optional",
          "options": [
            "No, grew up in India",
            "Yes — currently abroad",
            "Yes — returned to India"
          ]
        },
        {
          "id": "prompt_1",
          "label": "Prompt 1",
          "type": "prompt",
          "status": "required",
          "prompt_text": "The way to my heart is...",
          "max_chars": 150
        },
        {
          "id": "prompt_2",
          "label": "Prompt 2",
          "type": "prompt",
          "status": "required",
          "prompt_text": "I'll know it's the right person when...",
          "max_chars": 150
        },
        {
          "id": "prompt_3",
          "label": "Prompt 3",
          "type": "prompt",
          "status": "required",
          "prompt_text": "My ideal Sunday looks like...",
          "max_chars": 150
        },
        {
          "id": "photo_urls",
          "label": "Photos",
          "type": "photo_upload",
          "status": "required",
          "min_count": 3,
          "max_count": 8
        }
      ]
    },
