rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function threadDoc(id) {
      return /databases/$(database)/documents/chat_threads/$(id);
    }

    // Thread ids are sorted uidA_uidB (Firebase uids do not contain underscores).
    function isParticipantInThreadId(id) {
      return isSignedIn()
        && request.auth.uid in id.split('_');
    }

    function isMemberOfExistingThread() {
      return isSignedIn()
        && request.auth.uid in resource.data.members;
    }

    function isMessageThreadMember(threadId) {
      return isSignedIn()
        && exists(threadDoc(threadId))
        && request.auth.uid in get(threadDoc(threadId)).data.members;
    }

    function otherMember(members, uid) {
      return members[0] == uid ? members[1] : members[0];
    }

    function isValidReadByUpdate() {
      let oldReadBy = resource.data.get('readBy', []);
      let newReadBy = request.resource.data.get('readBy', []);
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
        && newReadBy.hasAll(oldReadBy)
        && request.auth.uid in newReadBy
        && !(request.auth.uid in oldReadBy);
    }

    function isValidHiddenForUpdate() {
      let oldHidden = resource.data.get('hiddenFor', []);
      let newHidden = request.resource.data.get('hiddenFor', []);
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hiddenFor'])
        && newHidden.hasAll(oldHidden)
        && request.auth.uid in newHidden
        && !(request.auth.uid in oldHidden);
    }

    function isValidReactionUpdate(threadId) {
      let uid = request.auth.uid;
      let oldReactions = resource.data.get('reactions', {});
      let newReactions = request.resource.data.get('reactions', {});
      let otherUid = otherMember(get(threadDoc(threadId)).data.members, uid);
      let otherOld = otherUid in oldReactions ? oldReactions[otherUid] : null;
      let otherNew = otherUid in newReactions ? newReactions[otherUid] : null;
      let otherUnchanged = otherOld == otherNew;
      let ownChangeValid =
        (uid in newReactions && newReactions[uid] is string)
        || (!(uid in newReactions) && uid in oldReactions);

      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
        && newReactions is map
        && otherUnchanged
        && ownChangeValid;
    }

    function isValidDeleteForEveryoneUpdate(threadId) {
      let thread = get(threadDoc(threadId)).data;
      let recipient = otherMember(thread.members, request.auth.uid);
      let oldReadBy = resource.data.get('readBy', []);
      return resource.data.senderId == request.auth.uid
        && request.resource.data.deletedForEveryone == true
        && resource.data.get('deletedForEveryone', false) == false
        && !(recipient in oldReadBy)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedForEveryone']);
    }

    match /chat_threads/{threadId} {
      // Existing threads: membership is enough for list/get queries.
      // Non-existent docs: allow get so getOrCreateThread can check existence.
      allow read: if isMemberOfExistingThread()
        || (isParticipantInThreadId(threadId) && !exists(threadDoc(threadId)));

      allow create: if isParticipantInThreadId(threadId)
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() == 2;

      allow update: if isMemberOfExistingThread()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members == resource.data.members;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && exists(threadDoc(threadId))
          && request.auth.uid in get(threadDoc(threadId)).data.members;

        allow create: if isSignedIn()
          && exists(threadDoc(threadId))
          && request.auth.uid in get(threadDoc(threadId)).data.members
          && request.resource.data.senderId == request.auth.uid;

        allow update: if isMessageThreadMember(threadId) && (
          isValidReadByUpdate()
          || isValidHiddenForUpdate()
          || isValidReactionUpdate(threadId)
          || isValidDeleteForEveryoneUpdate(threadId)
        );
      }
    }
  }
}
