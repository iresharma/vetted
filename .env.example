# Copy to .env and fill in values. Never commit .env.

# Supabase (optional)
SUPABASE_ANON_KEY=

# Razorpay publishable key used by Checkout in app
RAZORPAY_KEY_ID=rzp_test_your_key_id

# Functions region (default asia-south1)
# FUNCTIONS_REGION=asia-south1

# Optional for local emulator wiring
# FUNCTIONS_USE_EMULATOR=true
# FUNCTIONS_EMULATOR_HOST=localhost
# FUNCTIONS_EMULATOR_PORT=5001

# Dev only — skip checkout (set false for real Razorpay flow)
PAYMENT_BYPASS=false
