# Copy to .env and fill in values. Never commit .env.

# Supabase (optional)
SUPABASE_ANON_KEY=

# Razorpay publishable key used by Checkout in app
RAZORPAY_KEY_ID=rzp_test_your_key_id

# Functions region (default asia-south1)
# FUNCTIONS_REGION=asia-south1

# Optional for local emulator wiring
# FUNCTIONS_USE_EMULATOR=true
# iOS simulator: 127.0.0.1 · Android emulator: 10.0.2.2 (defaults apply if unset)
# FUNCTIONS_EMULATOR_HOST=127.0.0.1
# FUNCTIONS_EMULATOR_PORT=5001

# Dev only — skip checkout (set false for real Razorpay flow)
PAYMENT_BYPASS=false

# Dev scripts (seed-test-users.js, cleanup-test-users.js, etc.)
# Download from Firebase Console → Project settings → Service accounts → Generate new private key
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/vetted-dev-firebase-admin.json
# FIREBASE_PROJECT_ID=vetted-dev-ea19c
# NEON_DATABASE_URL=postgresql://...
# CONFIRM_DEV_SEED=yes

# iOS Simulator / emulator: App Check uses debug provider in debug builds automatically.
# Register the UUID printed at startup in Firebase Console → App Check → Manage debug tokens.
# APP_CHECK_DEBUG=true
