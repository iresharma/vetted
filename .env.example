# Copy to .env and fill in values. Never commit .env.

# Supabase (optional)
SUPABASE_ANON_KEY=

# Razorpay — Dashboard → API Keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# Optional: existing monthly plan from Dashboard → Subscriptions → Plans
# RAZORPAY_PLAN_ID=plan_your_plan_id

# Dev only — skip checkout (set false for real Razorpay flow)
PAYMENT_BYPASS=false
